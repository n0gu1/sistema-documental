# Development defaults. Never commit real credentials.
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE_URL takes precedence over DB_* variables when provided.
DATABASE_URL=
DB_NAME=sistema_documental
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=
DB_CONN_MAX_AGE=600

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

MAX_UPLOAD_SIZE_MB=50
MAX_REQUEST_SIZE_MB=250
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.jpg,.jpeg,.png

# Use S3-compatible storage in production. Filesystem storage is for local development.
STORAGE_BACKEND=filesystem
MEDIA_ROOT=media
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-005
AWS_S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
AWS_LOCATION=documentos
